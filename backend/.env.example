# Application
APP_NAME=Multi-LLM Custom ChatGPT
APP_VERSION=0.1.0
API_PREFIX=/api

# CORS origins. Comma-separated. Do not use "*".
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production: add the Vercel origin, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared LLM request limits
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
MAX_PROMPT_LENGTH=8000

# LLM provider keys. Leave empty to start the backend without a provider configured.
# Never commit real keys. Never put these values in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Required only when the key is organization-scoped (not a workspace key).
# Copy the ID from Claude Console → Settings → Workspaces (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
